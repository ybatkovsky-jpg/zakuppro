generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// === COMPANY DETAILS ===
model CompanyDetails {
  id          String @id @default(cuid())
  companyName String
  inn         String @default("")
  kpp         String @default("")
  ogrn        String @default("")
  address     String @default("")
  email       String @default("")
  phone       String @default("")
  bankName    String @default("")
  bankAccount String @default("")
  korAccount  String @default("")
  bik         String @default("")
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// === SUPPLIERS ===
model Supplier {
  id           String @id @default(cuid())
  name         String
  email        String @default("")
  phone        String @default("")
  contactPerson String @default("")
  address      String @default("")
  notes        String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectItems   ProjectItem[]
  purchaseRequests PurchaseRequest[]
  invoices      Invoice[]
  emailLogs     EmailLog[]
  deliveries    Delivery[]
}

// === PROJECTS ===
model Project {
  id          String @id @default(cuid())
  name        String
  description String @default("")
  status      String @default("new") // new, processing, requested, invoiced, paid, delivered, completed, cancelled
  fileName    String @default("")
  customerName String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items          ProjectItem[]
  purchaseRequests PurchaseRequest[]
  invoices       Invoice[]
  emailLogs      EmailLog[]
  statusHistory  ProjectStatusHistory[]
  deliveries     Delivery[]
}

// === PROJECT ITEMS (positions from Excel) ===
model ProjectItem {
  id           String @id @default(cuid())
  projectId    String
  supplierId   String?
  name         String
  article      String @default("")
  category     String @default("")
  quantity     Int
  unit         String @default("шт")
  price        Float @default(0)
  isFromWarehouse Boolean @default(false)
  status       String @default("pending") // pending, requested, invoiced, partial, available, ordered, delivered, completed
  notes        String @default("")
  rowNumber    Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  requestItems PurchaseRequestItem[]
  invoiceItems InvoiceItem[]
  warehouseTransactions WarehouseTransaction[]
}

// === PURCHASE REQUESTS ===
model PurchaseRequest {
  id          String @id @default(cuid())
  projectId   String
  supplierId  String
  status      String @default("draft") // draft, sent, responded, partial, cancelled
  emailTo     String @default("")
  emailSubject String @default("")
  emailBody   String @default("")
  sentAt      DateTime?
  responseAt  DateTime?
  notes       String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  items       PurchaseRequestItem[]
}

// === PURCHASE REQUEST ITEMS ===
model PurchaseRequestItem {
  id             String @id @default(cuid())
  requestId      String
  projectItemId  String
  quantity       Int
  price          Float @default(0)
  available      Boolean @default(false)
  availableQty   Int @default(0)
  deliveryDays   Int @default(0)
  notes          String @default("")

  request        PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  projectItem    ProjectItem @relation(fields: [projectItemId], references: [id])
}

// === INVOICES ===
model Invoice {
  id            String @id @default(cuid())
  projectId     String
  supplierId    String
  invoiceNumber String @default("")
  totalAmount   Float @default(0)
  status        String @default("received") // received, verified, discrepancy, approved, paid, cancelled
  receivedAt    DateTime @default(now())
  paidAt        DateTime?
  notes         String @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  items         InvoiceItem[]
  delivery      Delivery?
}

// === INVOICE ITEMS ===
model InvoiceItem {
  id             String @id @default(cuid())
  invoiceId      String
  projectItemId  String?
  name           String
  quantity       Int
  price          Float @default(0)
  isMatch        Boolean @default(false)
  mismatchReason String @default("")

  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  projectItem    ProjectItem? @relation(fields: [projectItemId], references: [id])
}

// === WAREHOUSE ===
model WarehouseItem {
  id          String @id @default(cuid())
  name        String
  article     String @default("")
  category    String @default("")
  quantity    Int @default(0)
  minQuantity Int @default(0)
  unit        String @default("шт")
  location    String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions WarehouseTransaction[]
}

// === WAREHOUSE TRANSACTIONS ===
model WarehouseTransaction {
  id              String @id @default(cuid())
  warehouseItemId String
  projectItemId   String?
  type            String // in, out
  quantity        Int
  notes           String @default("")
  createdAt       DateTime @default(now())

  warehouseItem   WarehouseItem @relation(fields: [warehouseItemId], references: [id], onDelete: Cascade)
  projectItem     ProjectItem? @relation(fields: [projectItemId], references: [id])
}

// === EMAIL LOG ===
model EmailLog {
  id          String @id @default(cuid())
  projectId   String?
  supplierId  String?
  direction   String // outgoing, incoming
  subject     String
  body        String @default("")
  from        String @default("")
  to          String @default("")
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
}

// === PROJECT STATUS HISTORY ===
model ProjectStatusHistory {
  id         String @id @default(cuid())
  projectId  String
  status     String
  fromStatus String @default("")
  toStatus   String @default("")
  comment    String @default("")
  changedBy  String @default("Система")
  notes      String @default("")
  createdAt  DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// === AUTOMATION RULES ===
model AutomationRule {
  id          String @id @default(cuid())
  name        String
  type        String  // auto_create_requests, auto_status_transition, etc.
  enabled     Boolean @default(false)
  config      String  @default("{}") // JSON config
  lastRunAt   DateTime?
  runCount    Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// === EMAIL SETTINGS (SMTP/IMAP) ===
model EmailSettings {
  id              String @id @default(cuid())
  // SMTP (отправка)
  smtpHost        String @default("")
  smtpPort        Int    @default(587)
  smtpUser        String @default("")
  smtpPassword    String @default("")
  smtpEncryption  String @default("tls") // tls, ssl, none
  senderName      String @default("")
  senderEmail     String @default("")
  emailSignature  String @default("")
  // IMAP (получение)
  imapHost        String @default("")
  imapPort        Int    @default(993)
  imapUser        String @default("")
  imapPassword    String @default("")
  imapEncryption  String @default("ssl") // ssl, tls, none
  imapCheckInterval Int  @default(15)    // минуты
  imapEnabled     Boolean @default(false)
  // Общие
  isConfigured    Boolean @default(false)
  lastCheckedAt   DateTime?
  // Результаты тестирования
  smtpTestResult  String @default("")     // "success" | "error" | ""
  imapTestResult  String @default("")     // "success" | "error" | ""
  smtpLastTestedAt DateTime?
  imapLastTestedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// === AI PROVIDER SETTINGS ===
model AiSettings {
  id              String @id @default(cuid())
  provider        String @default("z-ai")     // z-ai, openai, anthropic, yandex, custom
  model           String @default("glm-4")    // glm-4, gpt-4o, claude-3.5-sonnet, yandexgpt-lite
  apiKey          String @default("")
  apiEndpoint     String @default("")          // для custom провайдера
  temperature     Float  @default(0.7)
  maxTokens       Int    @default(4096)
  systemPrompt    String @default("")
  // Статус
  isConfigured    Boolean @default(false)
  lastTestedAt    DateTime?
  testResult      String @default("")          // success, error message
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// === TELEGRAM BOT SETTINGS ===
model TelegramSettings {
  id              String @id @default(cuid())
  botToken        String @default("")
  webhookUrl      String @default("")
  chatId          String @default("")           // ID чата с пользователем
  allowedUsers    String @default("[]")         // JSON array of allowed Telegram user IDs
  isConfigured    Boolean @default(false)
  isEnabled       Boolean @default(false)
  lastMessageAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// === DELIVERIES ===
model Delivery {
  id             String @id @default(cuid())
  projectId      String
  supplierId     String
  invoiceId      String? @unique
  status         String @default("pending") // pending, shipped, in_transit, delivered, cancelled
  trackingNumber String @default("")
  carrier        String @default("")  // ТК: Деловые Линии, ПЭК, СДЭК, etc.
  estimatedDate  DateTime?
  actualDate     DateTime?
  notes          String @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
}
