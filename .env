# =============================================================================
# ZakupPro — Environment Configuration
# =============================================================================

# =============================================================================
# Docker Compose Port Mapping
# =============================================================================
FRONTEND_PORT=3000
API_PORT=8100
# DB_PORT=5432
# RABBITMQ_PORT=5672
# RABBITMQ_MGMT_PORT=15672

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zakuppro
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/zakuppro
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@db:5432/zakuppro

# =============================================================================
# RabbitMQ (for Celery)
# =============================================================================
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
CELERY_BROKER_URL=pyamqp://guest:guest@rabbitmq:5672//

# =============================================================================
# Redis (for Celery — optional)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# LLM Provider Configuration
# =============================================================================
LLM_PRIMARY_PROVIDER=deepseek
LLM_SECONDARY_PROVIDER=anthropic
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# =============================================================================
# Telegram Bot
# =============================================================================
TELEGRAM_BOT_TOKEN=8798768452:AAEoNjUSTmHl2cXkqA33yFLrAMk_6hVyJnQ
TELEGRAM_OWNER_CHAT_ID=600270757
ALLOWED_CHAT_IDS=123456789,987654321

# =============================================================================
# Email (SMTP / IMAP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

EMAIL_WORKER_POLL_INTERVAL=60
EMAIL_WORKER_PROCESSED_IDS_FILE=/data/processed_message_ids.txt
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_app_password
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
IMAP_MAX_RETRIES=3
IMAP_RETRY_DELAY=1

# =============================================================================
# JWT Authentication (for backend/auth.py)
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Legacy Security (deprecated — use JWT_* above)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# FastAPI Backend Configuration (for Next.js proxy routes)
# =============================================================================
# Inside Docker, use the service name; for local dev use http://localhost:8000
FASTAPI_URL=http://api:8000

# DeepSeek API
DEEPSEEK_API_KEY=sk-b0071889961344d0aba3cee96d70e11d
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen API (Alibaba Cloud)
QWEN_API_KEY=sk-28cfcae7fec640d884c8a2bea1eecd87
QWEN_BASE_URL=ws-t4g2zoukmwv533wx.ap-southeast-1.maas.aliyuncs.com
QWEN_MODEL=qwen-plus
