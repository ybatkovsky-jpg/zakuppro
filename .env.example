# =============================================================================
# ZakupPro — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running:
#   cp .env.example .env
#   docker compose up -d --build
# =============================================================================

# =============================================================================
# Docker Compose Port Mapping
# =============================================================================
# Only frontend and API are exposed by default.
# DB and RabbitMQ are internal-only (uncomment ports in docker-compose.yml for debugging).
FRONTEND_PORT=3000
API_PORT=8000
# DB_PORT=5432          # Uncomment only for local development
# RABBITMQ_PORT=5672    # Uncomment only for local development
# RABBITMQ_MGMT_PORT=15672  # Uncomment only for local development

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zakuppro
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/zakuppro
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@db:5432/zakuppro

# =============================================================================
# RabbitMQ (for Celery)
# =============================================================================
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
CELERY_BROKER_URL=pyamqp://guest:guest@rabbitmq:5672//

# =============================================================================
# Redis (for Celery — optional, not used by default)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# LLM Provider Configuration
# =============================================================================
LLM_PRIMARY_PROVIDER=openai
LLM_SECONDARY_PROVIDER=anthropic
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# =============================================================================
# Telegram Bot
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_CHAT_ID=your_chat_id_here
ALLOWED_CHAT_IDS=123456789,987654321

# =============================================================================
# Email (SMTP / IMAP)
# =============================================================================
# SMTP (sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# IMAP (inbox polling for email worker)
EMAIL_WORKER_POLL_INTERVAL=60
EMAIL_WORKER_PROCESSED_IDS_FILE=/data/processed_message_ids.txt
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_app_password
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
IMAP_MAX_RETRIES=3
IMAP_RETRY_DELAY=1

# =============================================================================
# JWT Authentication (for backend/auth.py)
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Legacy Security (deprecated — use JWT_* above)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# FastAPI Backend Configuration (for Next.js proxy routes)
# =============================================================================
# FastAPI backend URL (for API client calls from Next.js server-side)
# Inside Docker, use the service name; for local dev use http://localhost:8000
FASTAPI_URL=http://api:8000

# Optional: Auth token for FastAPI API calls (if/when authentication is enabled)
# FASTAPI_AUTH_TOKEN=your_token_here
