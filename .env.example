# =============================================================================
# ZakupPro — Environment Configuration (TEMPLATE)
# Copy this file to .env and fill in your values
# =============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=zakuppro
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@db:5432/zakuppro
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/zakuppro

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
CELERY_BROKER_URL=pyamqp://guest:guest@rabbitmq:5672//

# JWT Auth
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECRET_KEY=CHANGE_ME_MIN_32_CHARS

# LLM Provider Configuration
LLM_PRIMARY_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash-exp
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_OWNER_CHAT_ID=YOUR_CHAT_ID_HERE
ALLOWED_CHAT_IDS=YOUR_CHAT_ID_HERE

# Email (optional)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Ports
FRONTEND_PORT=3000
API_PORT=8100
